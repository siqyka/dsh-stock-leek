{
  "name": "@shiqyka/dsh-stock-leek",
  "version": "0.7.0",
  "description": "DSH 股票插件：对话左下角大盘指数栏 + 行情悬浮窗（大盘/自选/持仓），支持 A股/北交所/港股/美股的分时、K线与持仓盈亏",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./shared": "./lib/shared.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node test/shared-drift.mjs && node test/config-isolation.mjs && node test/config-path.mjs && node test/test-routes.mjs && node test/security.mjs && node test/alert-loop-ref.mjs && node test/e2e-render.mjs",
    "test:shared": "node test/shared-drift.mjs",
    "test:isolation": "node test/config-isolation.mjs",
    "test:path": "node test/config-path.mjs",
    "test:routes": "node test/test-routes.mjs",
    "test:security": "node test/security.mjs",
    "test:e2e": "node test/e2e-render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "stock",
    "a-share",
    "行情",
    "盯盘",
    "自选股",
    "持仓"
  ],
  "homepage": "https://github.com/siqyka/dsh-stock-leek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siqyka/dsh-stock-leek.git"
  },
  "bugs": {
    "url": "https://github.com/siqyka/dsh-stock-leek/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
